<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- رؤية حزم تطبيقات «تطبيقاتنا حتى نرى أنّها مثبّتة ونفتحها مباشرة
         (مطلوبة من Android 11+ حيثُ تُخفى قوائم الحزم افتراضياً) -->
    <queries>
        <package android:name="com.muslim.adhkar.wird" />
        <package android:name="com.minbar.khatib" />
        <package android:name="com.mahdara.durus" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- شاشة الدعاء الكاملة التي تظهر حتى فوق القفل -->
        <activity
            android:name=".DuaReminderActivity"
            android:theme="@style/DuaReminderTheme"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="false" />

        <!-- توجيه انطلاق المؤقّتات إلى الواجهة الكاملة -->
        <receiver
            android:name=".DuaReminderReceiver"
            android:exported="false" />

        <!-- إعادة بناء الجدولة بعد الإقلاع / تغيّر الساعة والمنطقة الزمنية -->
        <receiver
            android:name=".DuaReminderBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- الودجات العائمة: يُعاد تشغيلها تلقائياً بعد إقلاع الجهاز -->
        <receiver
            android:name=".WidgetsBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- خدمة استضافة نوافذ الودجات (فوق كل التطبيقات وعلى شاشة القفل) -->
        <service
            android:name=".FloatingWidgetsService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_overlay_widgets_for_dhikr" />
        </service>

        <!-- ويدجات الشاشة الرئيسية (مسبحة الأذكار) -->
        <receiver
            android:name=".HomeCounterProvider"
            android:exported="false"
            android:label="@string/home_widget_counter_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_counter_info" />
        </receiver>

        <!-- ويدجات الشاشة الرئيسية (دعاء اليوم) -->
        <receiver
            android:name=".HomeDuaProvider"
            android:exported="false"
            android:label="@string/home_widget_dua_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dua_info" />
        </receiver>

        <!-- ويدجات الشاشة الرئيسية (أذكار الصباح) -->
        <receiver
            android:name=".HomeMorningAdhkarProvider"
            android:exported="false"
            android:label="@string/home_widget_morning_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_morning_info" />
        </receiver>

        <!-- ويدجات الشاشة الرئيسية (أذكار المساء) -->
        <receiver
            android:name=".HomeEveningAdhkarProvider"
            android:exported="false"
            android:label="@string/home_widget_evening_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_evening_info" />
        </receiver>

        <!-- ويدجات الشاشة الرئيسية (أسماء الله الحسنى) -->
        <receiver
            android:name=".HomeAsmaProvider"
            android:exported="false"
            android:label="@string/home_widget_asma_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_asma_info" />
        </receiver>

        <!-- ويدجات الشاشة الرئيسية (الصلاة القادمة + الوقت المتبقي) -->
        <receiver
            android:name=".HomePrayerProvider"
            android:exported="false"
            android:label="@string/home_widget_prayer_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prayer_info" />
        </receiver>

        <!-- نابض كل دقيقة ليبقى عدّاد الصلاة القادمة محدّثاً على الودجد -->
        <receiver
            android:name=".PrayerWidgetAlarmReceiver"
            android:exported="false" />

        <!-- إعادة التشغيل بعد الإقلاع وتغيّر الوقت والمنطقة الزمنية -->
        <receiver
            android:name=".PrayerWidgetBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- تحديث الودجات فورياً بعد تثبيت إصدار جديد من التطبيق -->
        <receiver
            android:name=".MyPackageReplacedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- قلب نبضي خلفي يحدّث ودجات الشاشة الرئيسية دون فتح التطبيق -->
        <receiver
            android:name=".WidgetsHeartbeatReceiver"
            android:enabled="true"
            android:exported="false" />

        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-6559329089674801~6363163092" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- للسماح بطلب إعفاء من تحسين البطارية حتى تصل الإشعارات المجدولة بعد إغلاق التطبيق -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- المؤقّتات الدقيقة للدعاء في منتصف الشاشة حتى بعد إغلاق التطبيق -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- إظهار الودجات العائمة فوق الشاشة المقفلة والمقفلة التطبيقات (Android 9+) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- الخدمة الأمامية التي تستضيف نوافذ الودجات -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- إشعارات أندرويد 13+: بدونها تُحذف إشعارات الدعاء بلا إظهار الواجهة الكاملة -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- الاهتزاز مع ظهور الدعاء (أندرويد 12+ يتطلب الإذن صراحةً) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- حفظ صور/فيديوهات التصدير في المعرض على أندرويد 9 فما دون
         (أندرويد 10+ لا يحتاج أي إذن بفضل MediaStore) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
</manifest>
